# Copy to .env and fill in. NEVER commit .env — it is git-ignored; keep it that way.
# Your team's LLM API key is handed out in person at the 31 Oct briefing.
OPENAI_API_KEY=

# Document services: generate separate random local values (32+ characters).
# These services do not call an LLM or send documents outside Docker/localhost.
DOCUMENT_WRITER_PASSWORD=
DOCUMENT_READER_PASSWORD=
DOCUMENT_API_KEY=
DOCUMENT_API_PORT=8081
# Existing local MySQL root password; change if your existing DB uses another.
DOCUMENT_ADMIN_PASSWORD=capstone

# Host-side Workbench access; containers still use mysql:3306.
MYSQL_HOST_PORT=3307
